# Desenvolvimento local. No Render, render.yaml injeta DATABASE_URL e SESSION_SECRET.
DATABASE_URL=sqlite:///./kritikus_local.db
SESSION_SECRET=replace-with-a-very-long-random-secret-at-least-32-chars
ENVIRONMENT=development
